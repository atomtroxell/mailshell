{
  "name": "mailshell",
  "productName": "MailShell",
  "version": "0.1.0-beta.1",
  "description": "MailShell - a free desktop app for Gmail",
  "main": ".vite/build/index.js",
  "private": true,
  "author": "AJ Troxell",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/stamp-legal.mjs && electron-forge start",
    "package": "node scripts/stamp-legal.mjs && electron-forge package",
    "make": "node scripts/stamp-legal.mjs && electron-forge make",
    "publish": "electron-forge publish",
    "build": "node scripts/stamp-legal.mjs && electron-forge package",
    "lint": "eslint --ext .ts,.tsx src/",
    "installer": "npm run package && electron-builder --prepackaged out/MailShell-win32-x64 --config electron-builder.yml --win nsis"
  },
  "keywords": [],
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^5.1.4",
    "dotenv": "^17.3.1",
    "electron": "40.6.1",
    "electron-builder": "^26.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "electron-conf": "^1.3.0",
    "electron-log": "^5.4.3",
    "electron-squirrel-startup": "^1.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
