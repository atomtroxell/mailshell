# Infomaniak OAuth credentials
# Obtain from https://manager.infomaniak.com -> Developer -> Applications
INFOMANIAK_CLIENT_ID=your_infomaniak_client_id_here
INFOMANIAK_CLIENT_SECRET=your_infomaniak_client_secret_here

# Google OAuth credentials
# Obtain from https://console.cloud.google.com -> APIs & Services -> Credentials
# Create a Desktop app OAuth 2.0 client ID
GOOGLE_CLIENT_ID=your_google_client_id_here
